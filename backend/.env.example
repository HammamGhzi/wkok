# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Ambil dari: Supabase → Project Settings → Database → Connection String
# Pakai "Transaction" mode (port 6543) untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pakai "Session" mode (port 5432) untuk DIRECT_URL (migrasi)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_64_karakter_di_production
JWT_EXPIRES_IN=24h

# ─── Seed Admin (hanya untuk `npm run db:seed`) ───────────────────────────────
# Repo ini PUBLIK. Kalau ada password default di dalam kode, siapa pun bisa
# login ke admin panel. Seed mewajibkan password dari env minimal 12 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Hapus lagi dari environment setelah seed berhasil.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL Vercel FE kamu (pisah koma kalau lebih dari satu)
FRONTEND_URL=https://nama-app-kamu.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# PENTING: nilai di bawah dikali jumlah instance Render yang aktif.
# Rate limit memakai MemoryStore (in-memory per-process), jadi setiap
# instance punya hitungan sendiri. Dengan 2 instance, max=3 -> 6 request.
#
# Kalau trafik naik dan Render menjalankan lebih banyak instance, turunkan
# angka ini supaya limit efektif tetap sesuai yang kamu maksud.
#
# Fix yang sebenarnya: shared store (Redis) supaya semua instance berbagi
# hitungan yang sama.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMIT=3

# ─── Telegram Bot (opsional) ──────────────────────────────────────────────────
# Ambil dari @BotFather. JANGAN commit token asli.
TELEGRAM_BOT_TOKEN=
# Chat ID admin (angka). Bot hanya boleh mengirim ke chat ini.
TELEGRAM_ADMIN_CHAT_ID=
# WAJIB diisi kalau memakai webhook mode. Token acak panjang, misal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kirim juga sebagai secret_token saat mendaftarkan webhook di BotFather.
# Kalau kosong, endpoint /api/telegram/webhook otomatis DITUTUP (403).
TELEGRAM_WEBHOOK_SECRET=

# Cache daftar menfes publik (halaman 1 saja, maks 20 kunci).
# Isi 0 untuk mematikan cache sepenuhnya.
MENFES_CACHE_TTL_MS=30000

# ─── Cloudinary (penyimpanan foto pengirim) ──────────────────────────────────
# Tiga nilai dari Console Cloudinary -> Settings -> API Keys.
# WAJIB — foto pengirim diunggah ke sini, dan asetnya harus bertahan jauh
# setelah upload (Meta bisa meminta fotonya belakangan). Kalau salah satu
# kosong, submit membawa foto akan gagal.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
