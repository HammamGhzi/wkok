generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Status buka/tutup menfess untuk publik ────────────────────────────────────
// Hanya ada SATU baris (id "utama"): ini bukan data per-baris melainkan sakelar
// situs. Sakelar ini kini bertiga lewat `mode`:
//
//   'auto'  — bawaan. Buka/tutup ditentukan OTOMATIS oleh jadwal jam buka
//             (08-10, 12-14, 16-21 WIB) yang hidup sebagai konstanta di
//             siteController — tidak disimpan di sini supaya tidak ada dua
//             sumber kebenaran yang bisa berbeda.
//   'buka'  — admin memaksa buka, menang atas jadwal, sampai admin sendiri
//             yang mengembalikan ke 'auto'.
//   'tutup' — admin memaksa tutup, menang atas jadwal, sampai admin sendiri
//             yang mengembalikan ke 'auto'.
//
// `isOpen` adalah sisa bentuk lama (sakelar dua posisi). Tidak di-drop supaya
// migrasi bersifat additive; tulisan baris ini sudah tidak dibaca kode lagi.
model SiteSetting {
  id        String   @id
  isOpen    Boolean  @default(true)
  mode      String   @default("auto")
  updatedAt DateTime @updatedAt
}

model Menfes {
  id         String    @id @default(uuid())
  message    String
  senderName String?
  senderInfo String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?
  ipHash     String?

  // ── Publikasi ke Instagram ────────────────────────────────────────────────
  // Semua nullable dan semua opsional: menfes yang sudah ada di database tidak
  // pernah menyentuhnya, dan menfes yang belum diposting indistinguishable dari
  // menfes biasa. Kolom ini sengaja terpisah dari `status` di atas, karena
  // `status` mewakili keputusan editorial (tampil atau tidak di web) sedangkan
  // igStatus mewakili perkembangan teknis di luar aplikasi.
  //
  // igStatus: NULL (belum pernah diposting) | PENDING (sedang berjalan) |
  //           PUBLISHED | FAILED
  // Sengaja tanpa nilai bawaan: menambahkan DEFAULT berarti menulis nilai itu
  // ke 444 baris yang sudah ada, dan tabel seukuran itu tidak perlu dibuka
  // ulang. NULL sudah cukup untuksayapembeda "belum pernah" dari "sudah".
  igStatus     String?
  igMediaId    String?
  igPermalink  String?
  igCaption    String?
  igImageUrl   String?
  igError      String?
  igPublishedAt DateTime?

  // ── Foto opsional dari pengirim ────────────────────────────────────────────
  // URL absolut ke Cloudinary ('https://res.cloudinary.com/.../foto-<hex>.png')
  // supaya asetnya bertahan lepas dari disk server (disk Render hapus tiap
  // redeploy, sedangkan Meta bisa meminta fotonya berjam-jam kemudian).
  // NULL = tanpa foto (post IG jadi kartu tunggal). Nilai lama berupa path
  // relatif ('/uploads/foto/<namafile>') masih ditangani semua pembaca.
  // Foto TIDAK pernah ikut di response API publik — hanya dashboard dan
  // jalur publish Instagram yang membacanya.
  fotoUrl String?

  // ── Video opsional dari pengirim ───────────────────────────────────────────
  // Satu lampiran saja: foto ATAU video, tidak dua-duanya. Isinya URL absolut
  // Cloudinary hasil transformasi yang sudah dibingkai + dinormalkan ke MP4
  // H.264 (lihat FRAME_VIDEO di lib/cloudinary.js), jadi yang disimpan adalah
  // bentuk final yang diterima Instagram. NULL = tanpa video.
  videoUrl String?

  // ── Lagu pilihan pengirim (opsional) ───────────────────────────────────────
  // Snapshot metadata hasil pencarian: { videoId, title, artist, duration,
  // thumb }. HANYA dibaca dashboard admin (preview embed YouTube resmi 30
  // detik); TIDAK PERNAH ikut response API publik maupun caption/postingan
  // Instagram. NULL = tanpa lagu (semua baris lama).
  music Json?

  @@index([status])
  @@index([createdAt])
  @@index([igStatus])
}
